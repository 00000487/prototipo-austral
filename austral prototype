<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ecosistema Digital B2B — Distribuidora Austral SpA</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --blue:        #1E3A8A;
  --blue-h:      #1E40AF;
  --blue-mid:    #2563EB;
  --blue-light:  #DBEAFE;
  --green:       #10B981;
  --green-h:     #059669;
  --green-light: #D1FAE5;
  --red:         #EF4444;
  --red-light:   #FEE2E2;
  --amber:       #F59E0B;
  --amber-light: #FEF3C7;
  --bg:          #F3F4F6;
  --card:        #FFFFFF;
  --text:        #111827;
  --muted:       #6B7280;
  --border:      #E5E7EB;
  --sidebar-w:   260px;
  --r:           12px;
  --sh:          0 1px 3px rgba(0,0,0,.07), 0 4px 16px rgba(0,0,0,.05);
}

body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); display:flex; min-height:100vh; overflow-x:hidden; }

/* ─ SIDEBAR ─ */
#sidebar {
  width:var(--sidebar-w); min-height:100vh; background:var(--blue);
  position:fixed; top:0; left:0; z-index:200; display:flex; flex-direction:column;
}
.sb-brand { padding:24px 20px 18px; border-bottom:1px solid rgba(255,255,255,.1); }
.sb-brand h2 { color:#fff; font-size:14px; font-weight:700; line-height:1.4; }
.sb-brand p  { color:rgba(255,255,255,.5); font-size:11px; margin-top:3px; text-transform:uppercase; letter-spacing:.07em; }
.sb-live { display:inline-flex; align-items:center; gap:5px; background:rgba(16,185,129,.2); color:#6EE7B7; font-size:10px; font-weight:700; padding:3px 9px; border-radius:20px; margin-top:8px; letter-spacing:.05em; text-transform:uppercase; }
.sb-live::before { content:''; width:6px; height:6px; border-radius:50%; background:#10B981; display:block; animation:blink 1.4s infinite; }
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.3;} }
nav { flex:1; padding:14px 10px; overflow-y:auto; }
.nav-label { font-size:10px; font-weight:600; color:rgba(255,255,255,.35); text-transform:uppercase; letter-spacing:.1em; padding:10px 10px 4px; }
.nav-item {
  display:flex; align-items:center; gap:10px; padding:10px 12px; border-radius:8px;
  color:rgba(255,255,255,.7); font-size:13px; font-weight:500; cursor:pointer;
  transition:background .15s, color .15s; margin-bottom:2px; user-select:none;
}
.nav-item:hover { background:rgba(255,255,255,.09); color:#fff; }
.nav-item.active { background:rgba(255,255,255,.16); color:#fff; font-weight:600; }
.nav-item .ni-icon { width:17px; height:17px; flex-shrink:0; }
.sb-footer { padding:14px 20px; border-top:1px solid rgba(255,255,255,.1); }
.sb-footer p { color:rgba(255,255,255,.35); font-size:10px; line-height:1.6; }

/* ─ MAIN ─ */
#main { margin-left:var(--sidebar-w); flex:1; display:flex; flex-direction:column; }
.topbar {
  background:var(--card); border-bottom:1px solid var(--border);
  padding:13px 26px; display:flex; align-items:center; justify-content:space-between;
  position:sticky; top:0; z-index:100;
}
.tb-left h1 { font-size:17px; font-weight:700; }
.tb-left p  { font-size:11px; color:var(--muted); margin-top:2px; }
.tb-right   { display:flex; align-items:center; gap:10px; }
.tb-chip { display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; padding:4px 10px; border-radius:20px; }
.chip-blue  { background:var(--blue-light); color:var(--blue); }
.chip-green { background:var(--green-light); color:#065F46; }

/* ─ PAGES ─ */
.page { display:none; padding:24px 26px; animation:fadeIn .18s ease; }
.page.active { display:block; }
@keyframes fadeIn { from{opacity:0;transform:translateY(5px);} to{opacity:1;transform:translateY(0);} }

/* ─ LAYOUT HELPERS ─ */
.g2 { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.g3 { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
.g4 { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
.mb12 { margin-bottom:12px; } .mb16 { margin-bottom:16px; } .mb20 { margin-bottom:20px; } .mb24 { margin-bottom:24px; }
.row { display:flex; align-items:center; gap:10px; }
.flex1 { flex:1; }

/* ─ CARDS ─ */
.card { background:var(--card); border-radius:var(--r); box-shadow:var(--sh); padding:18px; }
.sec-title { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.08em; margin-bottom:14px; }

/* ─ STAT CARD ─ */
.stat-val { font-size:26px; font-weight:800; color:var(--blue); line-height:1; margin-bottom:2px; }
.stat-lbl { font-size:12px; color:var(--muted); }
.stat-delta { font-size:11px; font-weight:600; color:var(--green); margin-top:5px; }
.stat-delta.neg { color:var(--red); }

/* ─ BADGES ─ */
.bdg { display:inline-flex; align-items:center; font-size:11px; font-weight:600; padding:3px 9px; border-radius:20px; white-space:nowrap; }
.bdg-green  { background:var(--green-light); color:#065F46; }
.bdg-red    { background:var(--red-light);   color:#991B1B; }
.bdg-amber  { background:var(--amber-light); color:#92400E; }
.bdg-blue   { background:var(--blue-light);  color:var(--blue); }
.bdg-dark   { background:var(--blue);        color:#fff; }

/* ─ BUTTONS ─ */
.btn { display:inline-flex; align-items:center; gap:6px; padding:9px 18px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; border:none; transition:background .15s, transform .1s; font-family:inherit; }
.btn:hover { filter:brightness(1.08); transform:translateY(-1px); }
.btn:active { transform:translateY(0); }
.btn-blue   { background:var(--blue);  color:#fff; }
.btn-blue:hover { background:var(--blue-h); }
.btn-green  { background:var(--green); color:#fff; }
.btn-green:hover { background:var(--green-h); }
.btn-red    { background:var(--red);   color:#fff; }
.btn-outline { background:transparent; color:var(--blue); border:1.5px solid var(--blue); }
.btn-sm     { padding:6px 13px; font-size:12px; border-radius:7px; }
.btn-xs     { padding:4px 10px; font-size:11px; border-radius:6px; }
.btn-full   { width:100%; justify-content:center; }

/* ─ TABLE ─ */
.tbl-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; font-size:13px; }
thead th { font-weight:600; color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.06em; border-bottom:1.5px solid var(--border); padding:8px 12px; text-align:left; white-space:nowrap; }
tbody td { padding:11px 12px; border-bottom:1px solid var(--border); vertical-align:middle; }
tbody tr:last-child td { border-bottom:none; }
tbody tr:hover { background:#FAFAFA; }

/* ─ PROGRESS ─ */
.prog-wrap { background:var(--bg); border-radius:20px; height:7px; overflow:hidden; }
.prog-bar  { height:100%; border-radius:20px; transition:width .5s ease; }
.pb-blue   { background:var(--blue); }
.pb-green  { background:var(--green); }
.pb-amber  { background:var(--amber); }
.pb-red    { background:var(--red); }

/* ─ FORM INPUTS ─ */
.inp, select.inp {
  padding:9px 12px; border:1.5px solid var(--border); border-radius:8px;
  font-size:13px; font-family:inherit; outline:none; background:#fff; color:var(--text);
  transition:border-color .15s; width:100%;
}
.inp:focus, select.inp:focus { border-color:var(--blue-mid); }

/* ─ MODULE 1 — PORTAL ─ */
.reorder-bar {
  background:linear-gradient(135deg,var(--blue) 0%,#1D4ED8 100%);
  border-radius:var(--r); padding:15px 20px; display:flex; align-items:center;
  justify-content:space-between; margin-bottom:20px;
}
.reorder-bar p { color:rgba(255,255,255,.85); font-size:13px; }
.reorder-bar strong { color:#fff; }

.prod-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:20px; }
.prod-card { background:var(--card); border-radius:var(--r); box-shadow:var(--sh); overflow:hidden; display:flex; flex-direction:column; }
.prod-img  { background:var(--blue-light); height:100px; display:flex; align-items:center; justify-content:center; font-size:44px; }
.prod-body { padding:14px; flex:1; display:flex; flex-direction:column; gap:6px; }
.prod-name { font-size:14px; font-weight:700; line-height:1.3; }
.prod-price { font-size:17px; font-weight:800; color:var(--blue); }
.prod-price span { font-size:11px; font-weight:500; color:var(--muted); }
.stk-row   { display:flex; justify-content:space-between; align-items:center; font-size:11px; color:var(--muted); margin-top:2px; }

.checkout-bar {
  background:var(--card); border-radius:var(--r); box-shadow:var(--sh); padding:18px;
  display:flex; align-items:flex-end; gap:14px; flex-wrap:wrap;
}
.checkout-bar label { font-size:12px; font-weight:600; color:var(--muted); display:block; margin-bottom:4px; }

/* ─ CART ─ */
.cart-panel {
  position:fixed; top:0; right:-390px; width:375px; height:100vh;
  background:var(--card); box-shadow:-6px 0 28px rgba(0,0,0,.13);
  z-index:500; transition:right .3s cubic-bezier(.4,0,.2,1);
  display:flex; flex-direction:column;
}
.cart-panel.open { right:0; }
.cart-overlay { position:fixed; inset:0; background:rgba(0,0,0,.28); z-index:499; display:none; backdrop-filter:blur(1px); }
.cart-overlay.on { display:block; }
.cart-head { padding:18px 20px; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between; }
.cart-head h3 { font-size:15px; font-weight:700; }
.cart-x { background:none; border:none; font-size:20px; cursor:pointer; color:var(--muted); line-height:1; }
.cart-body { flex:1; overflow-y:auto; padding:14px; }
.cart-empty { text-align:center; padding:40px 16px; color:var(--muted); }
.cart-empty span { font-size:36px; display:block; margin-bottom:8px; }
.ci { display:flex; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--border); }
.ci-icon { font-size:22px; width:34px; text-align:center; flex-shrink:0; }
.ci-info { flex:1; }
.ci-info p { font-size:13px; font-weight:600; }
.ci-info span { font-size:11px; color:var(--muted); }
.ci-price { font-size:14px; font-weight:700; color:var(--blue); }
.ci-rm { background:none; border:none; color:var(--red); cursor:pointer; font-size:15px; padding:2px; }
.cart-foot { padding:14px 20px; border-top:1px solid var(--border); }
.cart-total-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:5px; }
.cart-total-row span { font-size:13px; color:var(--muted); }
.cart-total-row .amt { font-size:22px; font-weight:800; color:var(--blue); }
.cart-tax { font-size:11px; color:var(--muted); margin-bottom:12px; }
.cart-fab {
  position:fixed; bottom:26px; right:26px; z-index:300;
  background:var(--blue); color:#fff; border:none; border-radius:50%;
  width:54px; height:54px; font-size:20px; cursor:pointer;
  box-shadow:0 4px 18px rgba(30,58,138,.45); display:flex; align-items:center; justify-content:center;
  transition:transform .15s;
}
.cart-fab:hover { transform:scale(1.07); }
.fab-badge {
  position:absolute; top:-4px; right:-4px; background:var(--green); color:#fff;
  font-size:10px; font-weight:700; border-radius:50%; width:20px; height:20px;
  display:flex; align-items:center; justify-content:center; pointer-events:none;
}

/* ─ MODULE 2 ─ */
.pipeline-wrap { display:flex; gap:12px; }
.pipe-col { flex:1; background:var(--bg); border-radius:10px; padding:12px; }
.pipe-col h4 { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); margin-bottom:10px; }
.pipe-card { background:var(--card); border-radius:8px; padding:11px 13px; margin-bottom:8px; box-shadow:0 1px 3px rgba(0,0,0,.06); border-left:3px solid transparent; transition:border-color .3s; }
.pipe-card.approved { border-color:var(--green); }
.pipe-card.transit  { border-color:var(--amber); }
.pipe-card.fulfilled{ border-color:var(--blue); }
.pipe-card p { font-size:13px; font-weight:600; margin-bottom:2px; }
.pipe-card .pipe-meta { font-size:11px; color:var(--muted); }

.inc-form { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:14px; }

/* ─ MODULE 3 ─ */
.route-map { background:linear-gradient(140deg,#EFF6FF 0%,#ECFDF5 100%); border-radius:var(--r); border:1.5px solid var(--border); overflow:hidden; }
.tele-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
.tele-card { background:var(--card); border-radius:10px; padding:15px; border:1.5px solid var(--border); transition:border-color .3s, background .3s; }
.tele-card.crit { border-color:var(--red); background:var(--red-light); animation:flash .9s infinite; }
@keyframes flash { 0%,100%{opacity:1;} 50%{opacity:.65;} }
.tele-temp { font-size:24px; font-weight:800; }
.tele-ok  { color:var(--green); }
.tele-bad { color:var(--red); }
.tele-sub { font-size:11px; color:var(--muted); margin-top:2px; }
.tele-status { font-size:11px; font-weight:600; margin-top:6px; }

/* ─ MODULE 4 ─ */
.kri-strip { border-top:3px solid var(--blue); }
.kpi-strip { border-top:3px solid var(--green); }
.met-row   { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
.met-lbl   { flex:1; font-size:13px; }
.met-val   { font-size:14px; font-weight:800; min-width:65px; text-align:right; }
.mv-ok     { color:var(--green); }
.mv-warn   { color:var(--amber); }
.mv-bad    { color:var(--red); }
.hoshin-strip {
  background:linear-gradient(135deg,var(--blue),#1D4ED8); border-radius:var(--r);
  display:flex; flex-wrap:wrap; overflow:hidden; margin-bottom:16px;
}
.hoshin-cell { flex:1; min-width:170px; padding:14px 18px; border-right:1px solid rgba(255,255,255,.15); }
.hoshin-cell:last-child { border-right:none; }
.hoshin-cell .hc-lbl { font-size:10px; color:rgba(255,255,255,.5); text-transform:uppercase; letter-spacing:.08em; margin-bottom:4px; }
.hoshin-cell .hc-val { font-size:13px; color:#fff; font-weight:600; line-height:1.4; }
.hoshin-arrow { font-size:20px; color:rgba(255,255,255,.4); display:flex; align-items:center; padding:0 4px; }

.a3-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.a3-cell { background:var(--card); border-radius:10px; padding:15px; border:1.5px solid var(--border); }
.a3-cell h4 { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--blue); margin-bottom:8px; }
.a3-cell p  { font-size:13px; line-height:1.7; }

/* ─ GLOBAL TOAST ─ */
.toast {
  position:fixed; top:18px; left:50%; transform:translateX(-50%);
  background:var(--text); color:#fff; padding:12px 22px; border-radius:10px;
  font-size:13px; font-weight:600; z-index:9999; box-shadow:0 6px 28px rgba(0,0,0,.22);
  opacity:0; transition:opacity .28s; pointer-events:none; white-space:nowrap;
}
.toast.ok   { background:var(--green); }
.toast.warn { background:var(--amber); color:var(--text); }
.toast.err  { background:var(--red); }
.toast.show { opacity:1; }

/* ─ SUCCESS OVERLAY ─ */
.success-overlay {
  position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:9000;
  display:none; align-items:center; justify-content:center; backdrop-filter:blur(3px);
}
.success-overlay.on { display:flex; }
.so-box { background:#fff; border-radius:16px; padding:40px 36px; text-align:center; max-width:420px; animation:popIn .3s cubic-bezier(.34,1.56,.64,1); }
@keyframes popIn { from{transform:scale(.8);opacity:0;} to{transform:scale(1);opacity:1;} }
.so-icon { font-size:56px; margin-bottom:12px; }
.so-box h2 { font-size:20px; font-weight:700; margin-bottom:6px; color:var(--blue); }
.so-box p  { font-size:13px; color:var(--muted); line-height:1.6; }
.so-divider { border:none; border-top:1px solid var(--border); margin:16px 0; }
.so-detail { background:var(--bg); border-radius:8px; padding:12px 16px; text-align:left; font-size:12px; line-height:1.8; color:var(--text); }
.so-detail strong { color:var(--blue); }

hr.div { border:none; border-top:1px solid var(--border); margin:16px 0; }

/* ─ SCROLLBAR ─ */
::-webkit-scrollbar { width:5px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:var(--border); border-radius:20px; }
</style>
</head>
<body>

<!-- GLOBAL TOAST -->
<div class="toast" id="toast"></div>

<!-- SUCCESS OVERLAY -->
<div class="success-overlay" id="so">
  <div class="so-box">
    <div class="so-icon">✅</div>
    <h2>Pedido Digital Enviado</h2>
    <p>El pedido ha sido registrado en el sistema y notificado al equipo de despacho. Tiempo estimado de confirmación: <strong>menos de 5 minutos</strong>.</p>
    <hr class="so-divider">
    <div class="so-detail" id="so-detail"></div>
    <button class="btn btn-blue" style="margin-top:18px;width:100%;justify-content:center;" onclick="closeSO()">Cerrar &amp; Ver Módulo Admin</button>
  </div>
</div>

<!-- SIDEBAR -->
<aside id="sidebar">
  <div class="sb-brand">
    <h2>Distribuidora Austral SpA</h2>
    <p>Cadena de Frío · Logística B2B</p>
    <span class="sb-live">Sistema en línea</span>
  </div>
  <nav>
    <div class="nav-label">Módulos</div>
    <div class="nav-item active" data-page="portal" onclick="go('portal')">
      <svg class="ni-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      Portal Cliente B2B
    </div>
    <div class="nav-item" data-page="admin" onclick="go('admin')">
      <svg class="ni-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Hub Admin &amp; CRM
      <span class="bdg bdg-red" id="nb-admin" style="margin-left:auto;font-size:10px;display:none;"></span>
    </div>
    <div class="nav-item" data-page="eco" onclick="go('eco')">
      <svg class="ni-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Eco-Logística &amp; Frío
    </div>
    <div class="nav-item" data-page="exec" onclick="go('exec')">
      <svg class="ni-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
      Dashboard Ejecutivo
    </div>
  </nav>
  <div class="sb-footer">
    <p>Prototipo Alta Fidelidad<br>Consultoría Estratégica Integral<br>IPSS · MD100TMDI · 2025</p>
  </div>
</aside>

<!-- MAIN -->
<main id="main">

  <!-- TOPBAR -->
  <div class="topbar">
    <div class="tb-left">
      <h1 id="tb-title">Portal Cliente B2B</h1>
      <p id="tb-sub">Vista: Chef / Encargado de Compras · Turno nocturno</p>
    </div>
    <div class="tb-right">
      <span class="tb-chip chip-green">🌡 Cadena de frío activa</span>
      <span class="tb-chip chip-blue">♻ Eco-Logística ON</span>
    </div>
  </div>

  <!-- ═══ PAGE 1: PORTAL ═══ -->
  <div class="page active" id="page-portal">

    <!-- Reorder bar -->
    <div class="reorder-bar">
      <div>
        <p><strong>🔁 Re-Orden con 1 Click</strong> — Último pedido registrado: 10 Jun 2025</p>
        <p style="font-size:12px;margin-top:2px;color:rgba(255,255,255,.75);">Lomo Liso ×2 · Salmón ×1 · Berries ×2 · Cheddar ×1 — Total ref.: <strong>$525.000</strong></p>
      </div>
      <button class="btn" style="background:#fff;color:var(--blue);" onclick="reorderAll()">↩ Repetir Pedido</button>
    </div>

    <!-- Product grid -->
    <p class="sec-title">Catálogo — Productos Congelados &amp; Refrigerados</p>
    <div class="prod-grid" id="prod-grid"></div>

    <!-- Checkout bar -->
    <div class="checkout-bar">
      <div style="flex:1;min-width:200px;">
        <label for="client-sel">Cuenta de cliente que realiza el pedido</label>
        <select class="inp" id="client-sel">
          <option value="">— Seleccionar cliente —</option>
          <option value="0">Restaurante El Gaucho Santiago</option>
          <option value="1">Cafetería Valparaíso Centro</option>
          <option value="2">Casino Central SpA</option>
          <option value="3">Minimarket El Progreso</option>
          <option value="4">Hotel Del Mar Viña</option>
          <option value="5">Cadena Sushi Pro</option>
        </select>

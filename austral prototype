        </div>
        <div class="prog-wrap" style="margin:4px 0 10px;"><div class="prog-bar ${stockBar(p.stock)}" style="width:${p.stock}%"></div></div>
        <button class="btn btn-blue btn-sm btn-full" onclick="addToCart(${p.id})">+ Agregar al Pedido</button>
      </div>
    </div>
  `).join('');
}

// ══════════════════════════════════════════════
// CART
// ══════════════════════════════════════════════
function addToCart(id) {
  cart[id] = (cart[id] || 0) + 1;
  refreshCart();
  toast(`${PRODUCTS.find(p=>p.id===id).emoji} Producto agregado al carrito`, 'ok');
}
function removeFromCart(id) { delete cart[id]; refreshCart(); }
function changeQty(id, delta) {
  cart[id] = (cart[id] || 0) + delta;
  if (cart[id] <= 0) delete cart[id];
  refreshCart();
}

function cartTotal() {
  let net = 0;
  Object.keys(cart).forEach(k => { net += PRODUCTS.find(p=>p.id==k).price * cart[k]; });
  return { net, tax: Math.round(net * 0.19), total: Math.round(net * 1.19) };
}

function refreshCart() {
  const keys = Object.keys(cart);
  const totals = cartTotal();
  const count = keys.reduce((a,k) => a + cart[k], 0);

  document.getElementById('fab-badge').textContent       = count;
  document.getElementById('fab-count-main').textContent  = count;

  const body = document.getElementById('cart-body');
  if (keys.length === 0) {
    body.innerHTML = `<div class="cart-empty"><span>🧊</span>Sin productos aún.<br>Agrega desde el catálogo.</div>`;
  } else {
    body.innerHTML = keys.map(k => {
      const p = PRODUCTS.find(x => x.id == k);
      return `
      <div class="ci">
        <div class="ci-icon">${p.emoji}</div>
        <div class="ci-info">
          <p>${p.name}</p>
          <span>$${p.price.toLocaleString('es-CL')} / u</span>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <button class="btn btn-xs btn-outline" onclick="changeQty(${p.id},-1)">−</button>
          <span style="font-weight:700;font-size:13px;">${cart[k]}</span>
          <button class="btn btn-xs btn-outline" onclick="changeQty(${p.id},1)">+</button>
        </div>
        <div class="ci-price">$${(p.price*cart[k]).toLocaleString('es-CL')}</div>
        <button class="ci-rm" onclick="removeFromCart(${p.id})">✕</button>
      </div>`;
    }).join('');
  }

  document.getElementById('ct-net').textContent   = '$' + totals.net.toLocaleString('es-CL');
  document.getElementById('ct-tax').textContent   = '$' + totals.tax.toLocaleString('es-CL');
  document.getElementById('ct-total').textContent = '$' + totals.total.toLocaleString('es-CL');
  document.getElementById('ct-items').textContent = count + ' producto(s) · Precios en CLP con IVA incluido';
}

function toggleCart() {
  document.getElementById('cart-panel').classList.toggle('open');
  document.getElementById('cart-overlay').classList.toggle('on');
}

function reorderAll() {
  cart = { 1:2, 2:1, 3:2, 4:1 };
  refreshCart();
  toast('🔁 Último pedido duplicado en el carrito', 'ok');
}

// ══════════════════════════════════════════════
// SUBMIT ORDER → CROSS-MODULE INJECTION
// ══════════════════════════════════════════════
function submitOrder() {
  if (Object.keys(cart).length === 0) { toast('⚠ Agrega productos antes de enviar', 'warn'); return; }
  const sel = document.getElementById('client-sel');
  const cIdx = sel.value;
  if (cIdx === '') { toast('⚠ Selecciona un cliente para el pedido', 'warn'); return; }

  const client = CLIENTS[parseInt(cIdx)];
  const totals  = cartTotal();
  const ordId   = 'PED-2025-0' + (++orderCounter);
  const now     = new Date();
  const timeStr = now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');

  // Build order items string
  const lines = Object.keys(cart).map(k => {
    const p = PRODUCTS.find(x => x.id == k);
    return `${p.emoji} ${p.name} ×${cart[k]}`;
  });

  // ── Inject into CRM ──
  CLIENTS[parseInt(cIdx)].lastOrder = '$' + totals.total.toLocaleString('es-CL');
  CLIENTS[parseInt(cIdx)].lastDate  = 'Ahora';
  renderCRM();

  // ── Inject into Pipeline ──
  pipeline.approved.unshift({ id: ordId, client: client.name, total: '$' + totals.total.toLocaleString('es-CL'), time: timeStr });
  renderPipeline();

  // ── Update revenue stat ──
  document.getElementById('s-orders').textContent = parseInt(document.getElementById('s-orders').textContent) + 1;

  // ── Admin badge ──
  newOrdersCount++;
  updateAdminBadge();

  // ── Show success overlay ──
  document.getElementById('so-detail').innerHTML =
    `<strong>ID Pedido:</strong> ${ordId}<br>
     <strong>Cliente:</strong> ${client.name}<br>
     <strong>Productos:</strong><br>${lines.map(l=>'&nbsp;&nbsp;'+l).join('<br>')}<br>
     <strong>Neto:</strong> $${totals.net.toLocaleString('es-CL')}<br>
     <strong>IVA 19%:</strong> $${totals.tax.toLocaleString('es-CL')}<br>
     <strong>Total:</strong> $${totals.total.toLocaleString('es-CL')}<br>
     <strong>Hora:</strong> ${timeStr}`;
  document.getElementById('so').classList.add('on');

  // Reset
  cart = {};
  refreshCart();
  if (document.getElementById('cart-panel').classList.contains('open')) toggleCart();
  sel.value = '';
}

function closeSO() {
  document.getElementById('so').classList.remove('on');
  go('admin');
}

// ══════════════════════════════════════════════
// CRM
// ══════════════════════════════════════════════
function renderCRM() {
  document.getElementById('crm-body').innerHTML = CLIENTS.map(c => `
    <tr>
      <td><strong>${c.name}</strong></td>
      <td>${c.seg}</td>
      <td><span class="bdg ${c.status === 'Activo' ? 'bdg-green' : c.status === 'En revisión' ? 'bdg-blue' : 'bdg-amber'}">${c.status}</span></td>
      <td style="font-weight:700;color:var(--blue);">${c.lastOrder} <span style="font-size:10px;color:var(--muted);font-weight:400;">${c.lastDate}</span></td>
    </tr>
  `).join('');
}

// ══════════════════════════════════════════════
// PIPELINE
// ══════════════════════════════════════════════
function renderPipeline() {
  const mkCol = (arr, cls) => arr.map(o => `
    <div class="pipe-card ${cls}">
      <p>${o.id}</p>
      <div class="pipe-meta">${o.client} · <strong>${o.total}</strong> · ${o.time}</div>
    </div>`).join('');
  document.getElementById('pipe-approved').innerHTML  = mkCol(pipeline.approved,  'approved');
  document.getElementById('pipe-transit').innerHTML   = mkCol(pipeline.transit,   'transit');
  document.getElementById('pipe-fulfilled').innerHTML = mkCol(pipeline.fulfilled, 'fulfilled');
}

// ══════════════════════════════════════════════
// INCIDENTS
// ══════════════════════════════════════════════
function renderIncidents() {
  document.getElementById('inc-body').innerHTML = incidents.map(i => `
    <tr>
      <td>${i.id}</td>
      <td>${i.type}</td>
      <td>${i.desc}</td>
      <td><span class="bdg ${i.cls}">${i.st}</span></td>
    </tr>`).join('');
  document.getElementById('s-inc').textContent = incidents.filter(i=>i.st!=='Resuelto').length;
}

function addIncident() {
  const desc = document.getElementById('inc-inp').value.trim();
  const type = document.getElementById('inc-type').value;
  if (!desc) { toast('⚠ Escribe una descripción', 'warn'); return; }
  incidents.unshift({ id:'INC-00'+incCounter++, type, desc, st:'Nuevo', cls:'bdg-blue' });
  renderIncidents();
  document.getElementById('inc-inp').value = '';
  toast('📋 Incidente registrado en el sistema', 'ok');
}

// ══════════════════════════════════════════════
// TELEMETRY
// ══════════════════════════════════════════════
function renderTele() {
  document.getElementById('tele-grid').innerHTML = teleState.map(t => `
    <div class="tele-card ${t.ok ? '' : 'crit'}">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <div>
          <div class="tele-temp ${t.ok ? 'tele-ok' : 'tele-bad'}">${t.temp.toFixed(1)}°C</div>
          <div class="tele-sub">${t.label}</div>
          <div class="tele-sub">Sensor #${t.sensor}</div>
        </div>
        <div style="font-size:28px;">${t.ok ? '✅' : '🚨'}</div>
      </div>
      <div class="tele-status" style="color:${t.ok ? 'var(--green)' : 'var(--red)'}">
        ${t.ok ? '● Normal (≤ −18°C)' : '⚠ ALERTA CRÍTICA — QUIEBRE DE FRÍO'}
      </div>
    </div>`).join('');
}

function simulateSpike() {
  spiked = !spiked;
  const btn = document.getElementById('spike-btn');
  if (spiked) {
    teleState[2].temp = -5.3;  teleState[2].ok = false;
    teleState[4].temp = -10.7; teleState[4].ok = false;
    teleState[5].temp = +2.1;  teleState[5].ok = false;
    // Push critical incident
    incidents.unshift({ id:'INC-00'+incCounter++, type:'Quiebre de frío', desc:'🚨 CRISIS: Falla servidor → R-03, R-05, R-06 temperatura crítica positiva', st:'Crítico', cls:'bdg-red' });
    renderIncidents();
    btn.textContent = '✅ Restaurar Sistema';
    btn.className   = 'btn btn-green btn-sm';
    toast('🚨 ALERTA CRÍTICA: Quiebre de frío activo en 3 unidades de flota', 'err');
    document.getElementById('co2-val').textContent = '0.0 ton';
    document.getElementById('co2-d').textContent   = '⚠ Sistema offline — datos interrumpidos';
    document.getElementById('co2-d').style.color   = 'var(--red)';
    newOrdersCount++;
    updateAdminBadge();
  } else {
    teleState = TELE_BASE.map(t => ({...t, ok:true}));
    btn.textContent = '⚡ Simulate Server Failure & Cold Chain Drop';
    btn.className   = 'btn btn-red btn-sm';
    toast('✅ Sistema restaurado. Cadena de frío estabilizada', 'ok');
    document.getElementById('co2-val').textContent = '2.4 ton';
    document.getElementById('co2-d').textContent   = '▲ +18% eficiencia vs. mes anterior';
    document.getElementById('co2-d').style.color   = 'var(--green)';
  }
  renderTele();
}

// ══════════════════════════════════════════════
// ADMIN BADGE
// ══════════════════════════════════════════════
function updateAdminBadge() {
  const nb = document.getElementById('nb-admin');
  if (newOrdersCount > 0) { nb.textContent = newOrdersCount; nb.style.display = 'inline-flex'; }
  else { nb.style.display = 'none'; }
}

// ══════════════════════════════════════════════
// TOAST
// ══════════════════════════════════════════════
function toast(msg, type='') {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.className   = 'toast ' + type + ' show';
  clearTimeout(t._tid);
  t._tid = setTimeout(() => t.classList.remove('show'), 3000);
}

// ══════════════════════════════════════════════
// INIT
// ══════════════════════════════════════════════
buildProducts();
renderCRM();
renderPipeline();
renderIncidents();
renderTele();
refreshCart();
</script>
</body>
</html>
